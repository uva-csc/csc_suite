{#
/**
 * @file
 * Masonry gallery of media images with a modal image popup.
 *
 * Available variables:
 * - view: The view.
 * - modal_id: Unique DOM id for this view instance's shared modal.
 * - tile_size: 'small', 'medium' or 'large'.
 * - modal_height: Modal image max height, as a percentage of viewport height.
 * - gallery_items: List of items, each with thumb_url, full_url, alt,
 *   caption and edit_url (NULL if the current user can't edit the media).
 */
#}
{% set column_widths = { small: '180px', medium: '260px', large: '340px' } %}
<div class="csc-gallery-masonry" style="--csc-gallery-column-width: {{ column_widths[tile_size] ?? column_widths.medium }}">
  {% for item in gallery_items %}
    <div class="csc-gallery-item">
      <button type="button"
        class="csc-gallery-trigger"
        data-bs-toggle="modal"
        data-bs-target="#{{ modal_id }}"
        data-full-src="{{ item.full_url }}"
        data-caption="{{ item.caption }}"
        data-alt="{{ item.alt }}">
        <img src="{{ item.thumb_url }}" alt="{{ item.alt }}" loading="lazy" />
        {% if item.caption %}
          <span class="csc-gallery-caption">{{ item.caption }}</span>
        {% endif %}
      </button>
      {% if item.edit_url %}
        <a href="{{ item.edit_url }}" class="csc-gallery-edit-link" target="_blank" rel="noopener" title="{{ 'Edit media'|t }}" aria-label="{{ 'Edit media'|t }}">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
          </svg>
        </a>
      {% endif %}
    </div>
  {% endfor %}
</div>

<div class="modal fade csc-gallery-modal" id="{{ modal_id }}" tabindex="-1" aria-hidden="true" style="--csc-gallery-modal-height: {{ modal_height }}vh">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content">
      <div class="modal-body csc-gallery-modal-body">
        <div class="csc-gallery-modal-image-wrap">
          <img src="" alt="" class="csc-gallery-modal-image" />
          <button type="button" class="csc-gallery-modal-close" data-bs-dismiss="modal" aria-label="{{ 'Close'|t }}">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path d="M2.146 2.146a.5.5 0 0 1 .708 0L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854a.5.5 0 0 1 0-.708z"/>
            </svg>
            <span class="csc-gallery-modal-close-label">{{ 'Close'|t }}</span>
          </button>
          <div class="csc-gallery-modal-caption"></div>
          {% if gallery_items|length > 1 %}
            <button type="button" class="csc-gallery-modal-nav csc-gallery-modal-prev" aria-label="{{ 'Previous image'|t }}" title="{{ 'Previous image'|t }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
              </svg>
            </button>
            <button type="button" class="csc-gallery-modal-nav csc-gallery-modal-next" aria-label="{{ 'Next image'|t }}" title="{{ 'Next image'|t }}">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M4.646 1.646a.5.5 0 0 1 .708 0l6 6a.5.5 0 0 1 0 .708l-6 6a.5.5 0 0 1-.708-.708L10.293 8 4.646 2.354a.5.5 0 0 1 0-.708z"/>
              </svg>
            </button>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
