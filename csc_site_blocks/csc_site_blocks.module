<?php

use Drupal\views\ViewExecutable;

/**
 * Implements hook_theme().
 */
function csc_site_blocks_theme() {
  return [
    'csc_skewed_block' => [
      'variables' => [
        'bgcolor' => '',
        'divheight' => '',
        'skewheight' => '',
        'angle' => '',
        'marginbottom' => '',
      ],
    ],
    'calendar_link_block' => [
      'variables' => [
        'message' => '',
        'node' => null,
        'dates' => [],
      ],
      'template' => 'calendar-link-block',
    ],
  ];
}


